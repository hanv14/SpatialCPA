__pycache__/
*.pyc
.venv/
scratchpad_*.py

# v15 benchmark outputs (regenerate with `python run_spatialcpa_v15.py`)
results_v15/

# T02 text-embedding cache (Config.text_cache_dir); rebuilt from resources/gene_meta.parquet
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Pilot / campaign run artifacts: results, logs, and per-dataset selections.
# A persisted selection is a measurement of a machine, not source.
runs/

# Fit checkpoints (`train_ctfflow(checkpoint=...)`). 49 MB each, no LFS, and Convention 3
# makes them regenerable from the seed — `reports/durability.md`: preserve the measurement,
# regenerate the model. `runs/` already covers the campaign's; this covers the rest.
*.pt
*.pt.tmp

# Campaign-machine run logs (`logs/fit_*.log`, `logs/arm_*.log`). The console record of one
# machine's scheduling; every number in them that matters is committed under `reports/`.
logs/

# Prediction intermediates written by the scoring runners (`_v2_io.write_prediction_h5`) and by
# each bootstrap/jackknife replicate. Fully regenerable from the committed reports and the seed,
# and there are hundreds of them: 190 of the 199 files in one commit attempt, which made the
# patch too large to transfer. The measurement is the report; these are scaffolding.
*.pred.h5ad
